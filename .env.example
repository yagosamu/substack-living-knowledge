# Copy to .env and adjust values. Placeholders are safe development defaults.
# Database credentials may stay commented: Settings and Compose already default to them.
# POSTGRES_USER=living_kb
# POSTGRES_PASSWORD=living_kb_pw
# POSTGRES_DB=living_kb
# Per-worktree ports and URLs are derived; uncomment only to override them.
# POSTGRES_PORT=5433
# DATABASE_URL=postgresql+asyncpg://living_kb:living_kb_pw@localhost:5433/living_kb

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=96
EMBEDDING_PRICE_PER_MILLION_TOKENS=0.02
OPENAI_API_KEY=

# Discovery and fetching
DISCOVERY_LIMIT=5
REQUEST_TIMEOUT_SECONDS=15
MAX_ARTICLE_BYTES=5242880
MIN_ARTICLE_CHARS=100
USER_AGENT=living-kb/0.1 (+https://github.com/yagosamu/substack-living-knowledge)

# Pipeline
INGEST_CONCURRENCY=3
STEP_RETRIES=3
MAX_STEP_OUTPUT_BYTES=3000000
PUBLICATIONS_REGISTRY_PATH=publications.yaml

# Inngest
INNGEST_APP_ID=living-kb
# INNGEST_BASE_URL=http://localhost:8288
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_PORT=8288

# API and health
# API_PORT=8000
# ADMINER_PORT=8081
HEALTH_CHECK_TIMEOUT_SECONDS=2.0

# Per-worktree stack (optional; derived from the checkout when unset)
# COMPOSE_PROJECT_NAME=living-kb-example
